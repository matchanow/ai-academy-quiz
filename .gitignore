# ── Shaxsiy ma'lumotlar ────────────────────────────────────────────
# db/ ichida o'quvchilarning ism-familiyasi, telefon raqami,
# pasport / ID raqami, ota-ona raqami va yashash joyi saqlanadi.
# Bunday ma'lumot repoga tushmasligi kerak.
# Server bo'sh bazada avtomatik seed qiladi (server.js), shuning uchun
# klon qilib darhol ishga tushirish mumkin.
db/

# O'quvchilarning ovoz yozuvlari: a-<vaqt>-<kod>.webm
# Diktant audiosi (dictation-*.ogg) esa repoda qoladi — u o'qituvchi
# tayyorlagan test materiali.
public/uploads/audio/a-*

