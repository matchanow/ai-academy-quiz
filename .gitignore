# ── Bog'liqliklar ──────────────────────────────────────────────────
node_modules/

# ── Baza ───────────────────────────────────────────────────────────
# Savollar va topshiriqlar repoda saqlanadi: server aynan shu mazmun
# bilan ishga tushishi kerak, seed namunalari bilan emas.
#
# Qolgan hamma narsa chiqarilmaydi — o'quvchilarning ism-familiyasi,
# telefoni, pasport / ID raqami, ota-ona raqami, manzili, javoblari,
# urinishlari va ovozli topshiriq natijalari.
db/*
!db/questions.json
!db/tasks.json

# O'quvchilarning ovoz yozuvlari: a-<vaqt>-<kod>.webm
# Diktant audiosi (dictation-*.ogg) esa repoda qoladi — u o'qituvchi
# tayyorlagan test materiali.
public/uploads/audio/a-*

# ── Bu papkada turgan, loyihaga aloqasi yo'q ishlar ────────────────
/Step one/
/Universitet/
/KiCad/
/Desigen/

# ── Muhit va tizim fayllari ────────────────────────────────────────
.env
.env.local
*.log
.DS_Store
Thumbs.db

